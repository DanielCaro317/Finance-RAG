# =============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO
# =============================================================================
# NOTA AL MARGEN:
#   Copia este archivo como ".env" y rellena los valores reales. Nunca
#   subas el .env real a git (ya está en .gitignore).
# =============================================================================

# ---- General -----------------------------------------------------------------
APP_ENV=local                 # local | staging | prod
LOG_LEVEL=INFO

# ---- Proveedor de LLM --------------------------------------------------------
# Elige UNO: "openai" | "anthropic" | "bedrock"
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini         # ej: gpt-4o-mini, claude-3-5-sonnet-20241022, anthropic.claude-3-5-sonnet-20241022-v2:0

# OpenAI (si LLM_PROVIDER=openai o EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=sk-...

# Anthropic (si LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# ---- Proveedor de Embeddings ------------------------------------------------
# Elige UNO: "openai" | "bedrock" | "huggingface"
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small   # 1536 dimensiones, barato y bueno.
# Para huggingface (corre local, sin costo): sentence-transformers/all-MiniLM-L6-v2

# ---- AWS (S3 / Bedrock) ------------------------------------------------------
# Si LLM_PROVIDER=bedrock o quieres subir docs a S3:
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
S3_BUCKET=mi-bucket-rag-financiero        # Cámbialo por uno tuyo.

# ---- Vector Store ------------------------------------------------------------
VECTOR_STORE=chroma           # chroma | pgvector
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=politicas_fraude

# ---- Re-ranker / Recuperación -----------------------------------------------
RETRIEVAL_TOP_K=10            # Cuántos chunks recuperar antes del reranker.
RERANK_TOP_N=4                # Cuántos pasan al LLM final.
HYBRID_ALPHA=0.5              # 0.0 = solo BM25, 1.0 = solo vectorial.

# ---- Observabilidad ----------------------------------------------------------
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=asistente-financiero

# ---- Servicio externo simulado (fraudes) ------------------------------------
FRAUD_API_URL=http://localhost:8000/mock/fraud
